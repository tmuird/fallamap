# Copy to .env and fill in.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx            # Clerk publishable key (pk_test_ / pk_live_)
VITE_SUPABASE_URL=https://YOURPROJECT.supabase.co # Supabase project URL
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx         # Supabase publishable/anon key
VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ1xxx              # Mapbox public token (pk.*)

# Server-side only (never bundled into the app): Postgres connection string used
# by scripts/seed_supabase.js to apply scripts/schema.sql and seed data.
# Supabase Dashboard → Project Settings → Connect → Session pooler → URI
SUPABASE_DB_URL=postgres://USER:PASSWORD@HOST:5432/postgres
